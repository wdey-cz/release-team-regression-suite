# Environment Configuration File
# Copy this file to .env and update with your actual values

# Application URL
BASE_URL=https://www.cozeva.com

# Browser Configuration
# Options: chrome, firefox, edge
BROWSER=chrome

# Run browser in headless mode (true/false)
HEADLESS=false

# Timeout Settings (in seconds)
DEFAULT_TIMEOUT=10
PAGE_LOAD_TIMEOUT=30
IMPLICIT_WAIT=0

# Test Credentials
# WARNING: Never commit actual credentials to version control
# Set these as environment variables or in a local .env file
TEST_USERNAME=your_username_here
TEST_PASSWORD=your_password_here

# Screenshot Settings
SCREENSHOT_ON_FAILURE=true
SCREENSHOTS_DIR=screenshots

# Reporting Settings
REPORTS_DIR=reports

# Logging Settings
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
